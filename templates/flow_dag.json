    },
    {
      "id": "flow2",
      "op": "flow",
      "src": 1,
      "dst": 3,
      "bytes": 2097152,
      "tag": 201,
      "depends_on": ["start"]
    },
    {
      "id": "flow2_compute",
      "op": "compute",
      "ranks": [3],
      "duration_ns": 1800,
      "depends_on": ["flow2"]
    },
    {
      "id": "flow3",
      "op": "flow",
      "src": 2,
      "dst": 3,
      "bytes": 3145728,
      "tag": 301,
      "depends_on": ["start"]
    },
    {
      "id": "flow3_compute",
      "op": "compute",
      "ranks": [3],
      "duration_ns": 2400,
