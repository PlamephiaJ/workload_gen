    "cpu": 0,
    "nic": 0,
    "chunk_bytes": 1048576
  },
  "nodes": [
    {
      "id": "start",
      "op": "compute",
      "ranks": [0, 1, 2, 3],
      "duration_ns": 0
    },
    {
      "id": "flow1",
      "op": "flow",
      "src": 0,
      "dst": 3,
      "bytes": 1048576,
      "tag": 101,
      "depends_on": ["start"]
    },
    {
      "id": "flow1_compute",
      "op": "compute",
      "ranks": [3],
